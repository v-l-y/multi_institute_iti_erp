# Docker Compose configuration; use different strong passwords in your local .env.
BACKEND_PORT=8080
DOCKER_DB_PASSWORD=replace-with-a-strong-app-password
DOCKER_DB_ROOT_PASSWORD=replace-with-a-different-root-password

# For the manual HTTPS overlay only: set to the specific Docker reverse-proxy CIDR.
# TRUSTED_PROXY_CIDRS=172.20.0.0/24

# Optional: official result/certificate *local imports* are disabled by default.
# Enable only after a reviewed government export is available and manually verified.
# ALLOW_OFFICIAL_RECORD_IMPORT=1
